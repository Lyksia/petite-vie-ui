{
  "name": "@petite-vie/ui",
  "version": "0.1.0",
  "description": "Petite Vie — la charte commune des jeux (Parent Life, My Life, Pet Life) : thème Tailwind v4, utilitaires, composants d'interface et icônes dessinées.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./index.css": "./src/index.css",
    "./theme.css": "./src/theme.css",
    "./utilities.css": "./src/utilities.css",
    "./base.css": "./src/base.css"
  },
  "bin": {
    "petite-vie-ui-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "assets",
    "bin"
  ],
  "peerDependencies": {
    "lucide-react": ">=1",
    "next": ">=16",
    "react": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "typescript": "^5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "packageManager": "pnpm@10.33.0"
}
