{
  "name": "@petite-vie/ui",
  "version": "0.5.1",
  "description": "Petite Vie — la charte commune des jeux (Parent Life, Life Story, Pet Life) : thème Tailwind v4, utilitaires, composants d'interface et icônes dessinées, le compte par code et l'accès admin à 8 chiffres (écrans + logique serveur).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./index.css": "./src/index.css",
    "./theme.css": "./src/theme.css",
    "./utilities.css": "./src/utilities.css",
    "./base.css": "./src/base.css",
    "./compte": "./src/compte/index.ts",
    "./reglages": "./src/reglages/index.ts",
    "./compte/serveur": {
      "types": "./dist/compte/serveur/index.d.ts",
      "default": "./dist/compte/serveur/index.js"
    }
  },
  "bin": {
    "petite-vie-ui-assets": "./bin/copy-assets.mjs",
    "petite-vie-admin-code": "./bin/admin-code.mjs"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "bin"
  ],
  "peerDependencies": {
    "lucide-react": ">=1",
    "next": ">=16",
    "react": ">=19",
    "tailwindcss": ">=4",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build:serveur": "tsc -p tsconfig.serveur.json",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.33.0"
}
